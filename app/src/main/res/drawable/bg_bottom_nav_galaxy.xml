<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>

    <item android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#22141B4D"
                android:centerColor="#2622D3EE"
                android:endColor="#225B21B6"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="top|left"
        android:top="10dp"
        android:left="34dp">
        <shape android:shape="oval">
            <solid android:color="#E0F2FE" />
        </shape>
    </item>

    <item
        android:width="3dp"
        android:height="3dp"
        android:gravity="top|right"
        android:top="14dp"
        android:right="54dp">
        <shape android:shape="oval">
            <solid android:color="#C4B5FD" />
        </shape>
    </item>
</layer-list>
