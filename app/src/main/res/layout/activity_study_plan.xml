<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_primary"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/ai_study_plan"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xl"
                android:fontFamily="sans-serif-medium" />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_or_subject"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_md"
                android:fontFamily="sans-serif-medium" />

            <Spinner
                android:id="@+id/sp_project"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@color/surface" />

            <EditText
                android:id="@+id/et_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:hint="@string/subject_hint"
                android:inputType="text"
                android:padding="@dimen/spacing_md"
                android:background="@color/surface"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/et_exam_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:hint="@string/exam_date"
                android:focusable="false"
                android:clickable="true"
                android:padding="@dimen/spacing_md"
                android:background="@color/surface"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/et_study_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:hint="@string/study_time_hint"
                android:inputType="text"
                android:padding="@dimen/spacing_md"
                android:background="@color/surface"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_generate_study_plan"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/generate_study_plan"
                app:cornerRadius="@dimen/btn_radius" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_saved_plans_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/saved_study_plans"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_lg"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_no_saved_plans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/no_saved_study_plans"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_md" />

            <LinearLayout
                android:id="@+id/layout_saved_plans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_sm" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
